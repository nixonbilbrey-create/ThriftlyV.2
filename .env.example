# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt each user's Gemini key at rest. Required — the server won't start without it.
ENCRYPTION_KEY=

# Public URL this server is reachable at — used to build verification links.
# The default is fine for local testing.
BASE_URL=http://localhost:3001

# --- Email (optional) ---
# Leave these blank to run in dev mode: verification links are printed to the
# server console and returned in the API response instead of emailed.
# Fill them in with any real SMTP provider (Gmail app password, SendGrid,
# Mailgun, Resend's SMTP relay, etc.) to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
PORT=3001
DB_PATH=
