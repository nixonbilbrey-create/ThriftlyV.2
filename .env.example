# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt each user's Gemini key at rest. Required — the server won't start without it.
ENCRYPTION_KEY=

# Public URL this server is reachable at — used to build verification and
# password-reset links. The default is fine for local testing.
BASE_URL=http://localhost:3001

# --- Email (optional) ---
# Leave these blank to run in dev mode: verification links are printed to the
# server console and returned in the API response instead of emailed.
# Fill them in with any real SMTP provider (Gmail app password, SendGrid,
# Mailgun, Resend's SMTP relay, etc.) to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Signup CAPTCHA (optional) ---
# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/).
# Leave both blank to disable. With both set, signup requires a passing
# challenge; the site key is public (served to the browser), the secret is
# server-side only and is checked against Turnstile's siteverify endpoint.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Backups (optional) ---
# Run the same backup the CLI produces on a schedule inside the server. Off by
# default; 24 = nightly. Keep BACKUP_DIR inside the persistent disk in production.
BACKUP_INTERVAL_HOURS=
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7
# Shell command run after each archive, e.g.
# BACKUP_UPLOAD_CMD='rclone copy {file} r2:thriftly-backups/prod && rclone copy {sha256} r2:thriftly-backups/prod'
BACKUP_UPLOAD_CMD=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
PORT=3001
# production enables HSTS, startup warnings, and is set by the Docker image
NODE_ENV=
DB_PATH=
# Where uploaded draft photos are stored as files (see photos.js);
# defaults to <project>/data/photos when unset.
PHOTOS_DIR=
