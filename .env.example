# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt each user's Gemini key at rest. Required — the server won't start
# without it, and only accepts 64 hex characters: a passphrase of that length is
# rejected at boot rather than failing on the first scan.
ENCRYPTION_KEY=

# Public URL this server is reachable at — used to build verification and
# password-reset links. The default is fine for local testing.
BASE_URL=http://localhost:3001

# --- Email (optional) ---
# Leave these blank to run in dev mode: verification links are printed to the
# server console and returned in the API response instead of emailed.
# Fill them in with any real SMTP provider (Gmail app password, SendGrid,
# Mailgun, Resend's SMTP relay, etc.) to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Signup CAPTCHA (optional) ---
# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/).
# Leave both blank to disable. With both set, signup requires a passing
# challenge; the site key is public (served to the browser), the secret is
# server-side only and is checked against Turnstile's siteverify endpoint.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Supabase (Postgres + Storage) ---
# Setting DATABASE_URL selects the async Postgres backend and Supabase Storage
# for photos; without it the app uses SQLite + local disk (local/test default).
# Use the session pooler URI (IPv4) — see docs/SUPABASE.md.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos
# How long /api/ready reuses a bucket check before asking Storage again (ms).
# The endpoint is public, so this is what stops probes from becoming Storage
# traffic. Failures are cached too, for the same reason. Blank, unparseable or
# negative values fall back to 10000 (with a warning) rather than disabling the
# cache; 0 disables it deliberately and warns.
STORAGE_CHECK_TTL_MS=10000
# Escape hatch for the startup guard in server.js: a Postgres app with no Storage
# credentials refuses to boot in production, because photos would land on an
# ephemeral filesystem and vanish on the next deploy. Set PHOTOS_ALLOW_LOCAL=1
# only if this host has a real persistent disk for photos/.
PHOTOS_ALLOW_LOCAL=

# --- Backups (SQLite shape only) ---
# Archives the SQLite db + local photo files from inside the server on a
# schedule. Off by default; 24 = nightly. Under Postgres the scheduler logs that
# it is skipped — production backups are Supabase's own plus an independent
# export (docs/backup-restore.md) — so leave these unset on Render.
BACKUP_INTERVAL_HOURS=
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7
# Shell command run after each archive, e.g.
# BACKUP_UPLOAD_CMD='rclone copy {file} r2:thriftly-backups/prod && rclone copy {sha256} r2:thriftly-backups/prod'
BACKUP_UPLOAD_CMD=

# Optional overrides
# Default model for scans/listings. Google retires IDs regularly (gemini-3.5-flash
# went in Oct 2026), so this is the current Flash model; if the API says it is
# gone, the fallbacks below are tried in order and the winner is reused.
# Email verification needs working SMTP, so by default it is required exactly when
# SMTP_HOST is set. Empty = follow that rule. Set "false" to sign people in without
# proving the address (weakens signup abuse protection); "true" to require it even
# without a relay, in which case the link only appears in the server log / devLink.
REQUIRE_EMAIL_VERIFICATION=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-flash-latest
# Total deadline per Gemini operation in milliseconds (default 45000). Each model
# attempt is capped at 15s; a stalled model falls through to the fallbacks above.
GEMINI_TIMEOUT_MS=
# Gemini API origin override for tests: they point it at a local fake so the scan
# pipeline runs without a real key. Ignored in production (where the server also
# refuses to start if it is set) so keys can only ever go to Google's API.
GEMINI_API_BASE=
PORT=3001
# production enables HSTS, startup warnings, and is set by the Docker image
NODE_ENV=
DB_PATH=
# Where uploaded draft photos are stored as files (see photos.js);
# defaults to <project>/data/photos when unset.
PHOTOS_DIR=
